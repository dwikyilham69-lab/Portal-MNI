# STIKES MNI — Apache config
Options -Indexes
DirectoryIndex index.php

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Protect includes folder
<FilesMatch "\.(php)$">
  <If "%{REQUEST_URI} =~ m#/includes/#">
    Require all denied
  </If>
</FilesMatch>
